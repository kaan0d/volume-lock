{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.0.1",
  "description": "__MSG_extDescription__",
  "permissions": ["storage", "tabs", "scripting", "tabCapture", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/low-volume-16.png"
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/low-volume-16.png",
    "48": "icons/low-volume-48.png",
    "128": "icons/low-volume-128.png"
  },
  "commands": {
    "volume-up": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "__MSG_cmdVolumeUp__"
    },
    "volume-down": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "__MSG_cmdVolumeDown__"
    },
    "toggle-mute": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "__MSG_cmdToggleMute__"
    },
    "save-site": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_cmdSaveSite__"
    }
  }
}
